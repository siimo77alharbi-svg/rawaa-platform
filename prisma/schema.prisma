generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Users & Authentication
model User {
  id            String   @id @default(uuid())
  email         String   @unique
  password      String
  name          String
  phone         String?
  role          Role     @default(CUSTOMER)
  avatar        String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relationships
  bookings      Booking[]
  payments      Payment[]
  subscriptions Subscription[]
  loyaltyPoints LoyaltyPoint[]
  smsLogs       SmsLog[]
  auditLogs     AuditLog[]

  @@map("users")
}

enum Role {
  CUSTOMER
  RECEPTIONIST
  THERAPIST
  ADMIN
  SUPER_ADMIN
}

// Booking & Services
model Service {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String
  duration    Int      // minutes
  price       Float
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    Booking[]
  schedules   Schedule[]
  subscriptions Subscription[]

  @@map("services")
}

model Booking {
  id          String   @id @default(uuid())
  userId      String
  serviceId   String
  therapistId String?
  date        DateTime
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  therapist   User?    @relation("TherapistBookings", fields: [therapistId], references: [id])
  payments    Payment[]
  schedule    Schedule?

  @@map("bookings")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

model Schedule {
  id          String   @id @default(uuid())
  serviceId   String
  therapistId String
  date        DateTime
  duration    Int      // minutes
  isAvailable Boolean @default(true)

  service     Service  @relation(fields: [serviceId], references: [id])
  therapist   User     @relation("TherapistSchedules", fields: [therapistId], references: [id])
  booking     Booking?

  @@unique([serviceId, therapistId, date])
  @@map("schedules")
}

// Payments & POS
model Payment {
  id          String   @id @default(uuid())
  bookingId   String
  amount      Float
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  receiptNo   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  booking     Booking  @relation(fields: [bookingId], references: [id])

  @@map("payments")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  WALLET
  PAYPAL
  MADA
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED
}

// Subscriptions & Memberships
model Subscription {
  id          String   @id @default(uuid())
  userId      String
  serviceId   String
  planType    SubscriptionPlan
  sessions    Int
  usedSessions Int @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  totalAmount Float
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])
  service     Service  @relation(fields: [serviceId], references: [id])
  payments    Payment[]

  @@map("subscriptions")
}

enum SubscriptionPlan {
  BASIC
  STANDARD
  PREMIUM
  VIP
}

// CRM & Loyalty
model LoyaltyPoint {
  id          String   @id @default(uuid())
  userId      String
  points      Int
  description String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("loyalty_points")
}

model Coupon {
  id          String   @id @default(uuid())
  code        String   @unique
  type        CouponType
  value       Float
  maxUses     Int?
  uses        Int      @default(0)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("coupons")
}

enum CouponType {
  PERCENTAGE
  FIXED
  FREE_SESSION
}

// Notifications (SMS & Email)
model SmsLog {
  id          String   @id @default(uuid())
  userId      String
  phone       String
  message     String
  type        SmsType
  status      SmsStatus @default(SENT)
  sentAt      DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("sms_logs")
}

enum SmsType {
  BOOKING_CONFIRMATION
  REMINDER
  PROMO
  GENERAL
}

enum SmsStatus {
  SENT
  DELIVERED
  FAILED
}

model EmailLog {
  id          String   @id @default(uuid())
  userId      String
  email       String
  subject     String
  body        String
  type        String
  status      String
  sentAt      DateTime @default(now())

  @@map("email_logs")
}

// Audit Logs
model AuditLog {
  id          String   @id @default(uuid())
  userId      String
  action      String
  entity      String
  entityId    String?
  details     String?
  ipAddress   String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

// Products (for POS)
model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Float
  stock       Int      @default(0)
  category    String?
  image       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

model CartItem {
  id          String   @id @default(uuid())
  productId   String
  quantity    Int      @default(1)
  addedAt     DateTime @default(now())

  product     Product  @relation(fields: [productId], references: [id])

  @@map("cart_items")
}